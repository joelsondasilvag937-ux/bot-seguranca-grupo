# Copie para .env e preencha os valores
NODE_ENV=production
PORT=3000

# VirusTotal API key (obrigatório se actions.virusTotalCheck = true)
VIRUSTOTAL_API_KEY=SEU_API_KEY_AQUI

# Opções
SESSION_DATA_PATH=.wwebjs_auth
# Optional: webhook para enviar QR ou notificações (use HTTPS + auth)
ADMIN_NOTIFY_WEBHOOK=
